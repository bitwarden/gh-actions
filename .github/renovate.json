{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>bitwarden/renovate-config"],
  "enabledManagers": [
    "dockerfile",
    "github-actions",
    "npm",
    "nuget",
    "pipenv",
    "regex"
  ],
  "ignorePaths": [
    "release-version-check/tests/fixtures/**",
    "version-bump/tests/fixtures/**",
    "**/node_modules/**"
  ],
  "packageRules": [
    {
      "additionalBranchPrefix": "{{parentDir}}-",
      "commitMessagePrefix": "[deps] {{parentDir}}:",
      "groupName": "minor",
      "matchManagers": [
        "dockerfile",
        "github-actions",
        "npm",
        "nuget",
        "pipenv"
      ],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepNames": ["anthropics/claude-code-action"],
      "matchUpdateTypes": ["patch"],
      "groupName": null,
      "dependencyDashboardApproval": false
    },
    {
      "matchDepNames": ["AikidoSec/safechain-internals"],
      "commitMessagePrefix": "[deps] setup-aikido-endpoint-protection:",
      "automerge": false,
      "prBodyNotes": [
        "Before approving, confirm the new SHA-256 matches the `digest` GitHub reports for `EndpointProtection-amd64.deb` on the release (`gh release view <tag> -R AikidoSec/safechain-internals --json assets`) and `SHA256_AMD64_DEB` in Aikido's `install-scripts/install-endpoint-linux.sh`."
      ]
    }
  ],
  "regexManagers": [
    {
      "fileMatch": ["proxy-actions/codecov/action.yml$"],
      "matchStrings": [
        "version:[\\s\\S]*?default: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "getsentry/prevent-cli",
      "datasourceTemplate": "github-releases"
    },
    {
      "fileMatch": ["validate-ai/action.yml$", "run-code-review/action.yml$"],
      "matchStrings": [
        "(?<depName>ghcr\\.io/github/github-mcp-server):(?<currentValue>v\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "fileMatch": ["setup-aikido-endpoint-protection/action.yml$"],
      "matchStrings": [
        "_AIKIDO_ENDPOINT_VERSION: (?<currentValue>v[0-9.]+)\\s+_AIKIDO_ENDPOINT_SHA256: (?<currentDigest>[a-f0-9]{64})"
      ],
      "depNameTemplate": "AikidoSec/safechain-internals",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver-coerced"
    }
  ]
}
